# Получите токен у @BotFather в Telegram и вставьте его после знака =
TELEGRAM_BOT_TOKEN=1234567890:replace_with_your_token

# Автоматическое обновление из личного кабинета МИБиУ.
CABINET_LOGIN_URL=https://lk.mibiu.ru/login
CABINET_DASHBOARD_URL=https://lk.mibiu.ru/dashboard
# Можно оставить пустым: бот попробует найти Excel автоматически.
CABINET_SCHEDULE_URL=
CABINET_USERNAME=your_email@example.com
CABINET_PASSWORD=replace_with_your_password
CABINET_USERNAME_FIELD=login
CABINET_PASSWORD_FIELD=password
CHECK_INTERVAL_MINUTES=30
